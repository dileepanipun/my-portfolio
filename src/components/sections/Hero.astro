---
import { Image } from "astro:assets";
import Container from "../Container.astro";
import { site } from "../../data/site";
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
import portrait from "../../assets/images/dileepa nipun salinda.webp";
import FloatingIcons from "../hero/FloatingIcons.astro";
---

<section
  id="top"
  aria-label="Introduction"
  class="relative flex min-h-[100svh] flex-col justify-between overflow-hidden pt-32 pb-16 md:pt-40"
>
  <!-- Subtle grid backdrop — one flat decorative element -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,black,transparent_75%)]"
  >
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  </div>

  <!-- Ambient floating tech icons (desktop/tablet only) -->
  <FloatingIcons />

  <!--
    Portrait — fixed-width column, bottom-anchored, sitting left of page center.
    Width is clamped so it stays proportional across all desktop sizes.
    `left` is clamped so on larger screens it drifts naturally toward the
    left third of the viewport rather than hugging the edge.
    `mix-blend-mode: screen` dissolves the near-black studio backdrop.
  -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 z-0 hidden md:block"
  >
    <Image
      src={portrait}
      alt=""
      widths={[480, 720, 960]}
      sizes="(min-width: 1024px) 28vw, 420px"
      loading="eager"
      decoding="async"
      class="h-[88vh] max-h-[860px] w-full object-contain object-bottom-right mix-blend-screen"
    />
    <!-- Right-edge dissolve into the dark bg so the figure doesn't hard-clip -->
    <div
      class="absolute inset-y-0 right-0 w-1/2 bg-[linear-gradient(to_right,transparent,var(--color-bg))]"
    ></div>
    <!-- Base vignette so feet merge into the section floor -->
    <div
      class="absolute inset-x-0 bottom-0 h-20 bg-[linear-gradient(to_bottom,transparent,var(--color-bg))]"
    ></div>
  </div>

  <!-- Mobile portrait — subtle, behind the copy -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 flex items-start justify-center md:hidden"
  >
    <Image
      src={portrait}
      alt=""
      widths={[360, 540, 720]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      class="h-[70%] w-auto max-w-none object-contain object-top mix-blend-screen opacity-40"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_45%,var(--color-bg)_88%)]"></div>
  </div>

  <Container class="relative z-10 flex flex-1 flex-col justify-center gap-12">
    <div class="ml-auto flex w-full max-w-2xl flex-col gap-3">
      <p
        data-reveal
        data-reveal-kind="fade-up"
        class="font-mono text-xs uppercase tracking-[0.24em] text-secondary"
      >
        {site.location} — Persuiting Life Long Learning
      </p>

      <h1
        data-reveal
        data-reveal-kind="chars"
        class="font-display font-medium tracking-[-0.04em] text-primary text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.92]"
      >
        {site.name}.
      </h1>

      <p
        data-reveal
        data-reveal-kind="lines"
        class="max-w-3xl font-display text-primary text-[clamp(1.25rem,2.4vw,2.25rem)] leading-[1.15] tracking-[-0.02em]"
      >
        {site.tagline}
      </p>
    </div>

    <div
      data-reveal
      data-reveal-kind="fade-up"
      class="ml-auto flex w-full max-w-2xl flex-wrap items-center gap-8 pt-4 md:w-[58%] md:max-w-none lg:w-[55%]"
    >
      <a
        href="#work"
        class="group inline-flex items-center gap-2 font-mono text-sm uppercase tracking-[0.18em] text-primary link-underline"
      >
        View work
        <ArrowDown
          size={16}
          stroke-width={1.5}
          class="transition-transform group-hover:translate-y-0.5"
        />
      </a>
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 font-mono text-sm uppercase tracking-[0.18em] text-secondary link-underline hover:text-primary"
      >
        Get in touch
        <ArrowUpRight
          size={16}
          stroke-width={1.5}
          class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </a>
    </div>
  </Container>

  <Container class="relative z-10 flex flex-col gap-4 pt-10 md:flex-row md:items-end md:justify-between">
    <p
      data-reveal
      data-reveal-kind="fade-up"
      class="max-w-md font-mono text-xs uppercase tracking-[0.2em] text-muted"
    >
      Portfolio — {new Date().getFullYear()} edition
    </p>
    <p
      data-reveal
      data-reveal-kind="fade-up"
      class="font-mono text-xs uppercase tracking-[0.2em] text-muted"
    >
      Scroll ↓
    </p>
  </Container>
</section>
