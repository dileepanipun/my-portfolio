---
import { Image } from "astro:assets";
import Container from "../Container.astro";
import { site } from "../../data/site";
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
import portrait from "../../assets/images/dileepa nipun salinda.webp";
---

<section
  id="top"
  aria-label="Introduction"
  class="relative flex min-h-[100svh] flex-col justify-between overflow-hidden pt-32 pb-16 md:pt-40"
>
  <!-- Subtle grid backdrop — one flat decorative element -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,black,transparent_75%)]"
  >
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  </div>

  <!--
    Portrait — positioned absolutely on desktop so the text keeps a natural
    reading rhythm while the figure anchors the left side of the frame.
    `mix-blend-mode: lighten` erases the near-black studio backdrop against
    the page background so only the subject reads through.
  -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-0 -z-10 hidden w-[52%] max-w-[720px] items-end md:flex lg:w-[46%]"
  >
    <div class="relative h-full w-full">
      <Image
        src={portrait}
        alt=""
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 1024px) 46vw, 52vw"
        loading="eager"
        decoding="async"
        class="absolute bottom-0 left-0 h-[92%] w-full object-cover object-bottom mix-blend-lighten opacity-95"
      />
      <!-- Soft right-edge falloff so the portrait blends into the text column -->
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,transparent_55%,var(--color-bg)_92%)]"
      ></div>
      <!-- Vertical vignette for a grounded base -->
      <div
        class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(to_bottom,transparent,rgba(10,10,10,0.6))]"
      ></div>
    </div>
  </div>

  <!-- Mobile portrait — subtle, behind the copy -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 flex items-start justify-center md:hidden"
  >
    <Image
      src={portrait}
      alt=""
      widths={[360, 540, 720]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      class="h-[70%] w-auto max-w-none object-contain object-top mix-blend-lighten opacity-25"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_40%,var(--color-bg)_85%)]"></div>
  </div>

  <Container class="relative flex flex-1 flex-col justify-center gap-12">
    <div class="ml-auto flex w-full max-w-2xl flex-col gap-3 md:w-[58%] md:max-w-none lg:w-[55%]">
      <p
        data-reveal
        data-reveal-kind="fade-up"
        class="font-mono text-xs uppercase tracking-[0.24em] text-secondary"
      >
        {site.location} — Available for new work
      </p>

      <h1
        data-reveal
        data-reveal-kind="chars"
        class="font-display font-medium tracking-[-0.04em] text-primary text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.92]"
      >
        {site.name}.
      </h1>

      <p
        data-reveal
        data-reveal-kind="lines"
        class="max-w-3xl font-display text-primary text-[clamp(1.25rem,2.4vw,2.25rem)] leading-[1.15] tracking-[-0.02em]"
      >
        {site.tagline}
      </p>
    </div>

    <div
      data-reveal
      data-reveal-kind="fade-up"
      class="ml-auto flex w-full max-w-2xl flex-wrap items-center gap-8 pt-4 md:w-[58%] md:max-w-none lg:w-[55%]"
    >
      <a
        href="#work"
        class="group inline-flex items-center gap-2 font-mono text-sm uppercase tracking-[0.18em] text-primary link-underline"
      >
        View work
        <ArrowDown
          size={16}
          stroke-width={1.5}
          class="transition-transform group-hover:translate-y-0.5"
        />
      </a>
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 font-mono text-sm uppercase tracking-[0.18em] text-secondary link-underline hover:text-primary"
      >
        Get in touch
        <ArrowUpRight
          size={16}
          stroke-width={1.5}
          class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </a>
    </div>
  </Container>

  <Container class="relative flex flex-col gap-4 pt-10 md:flex-row md:items-end md:justify-between">
    <p
      data-reveal
      data-reveal-kind="fade-up"
      class="max-w-md font-mono text-xs uppercase tracking-[0.2em] text-muted"
    >
      Portfolio — {new Date().getFullYear()} edition
    </p>
    <p
      data-reveal
      data-reveal-kind="fade-up"
      class="font-mono text-xs uppercase tracking-[0.2em] text-muted"
    >
      Scroll ↓
    </p>
  </Container>
</section>
