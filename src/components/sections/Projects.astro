---
import Container from "../Container.astro";
import SectionHeader from "../SectionHeader.astro";
import { projects } from "../../data/projects";
import { ArrowUpRight } from "@lucide/astro";
---

<section id="work" aria-labelledby="work-title" class="border-t border-border py-32 md:py-40">
  <Container>
    <SectionHeader index="03" eyebrow="Selected work" title="Recent projects." class="mb-24" />

    <ul class="flex flex-col gap-0">
      {
        projects.map((p, i) => (
          <li
            class="group border-t border-border last:border-b"
            data-reveal
            data-reveal-kind="fade-up"
          >
            <a
              href={p.liveUrl ?? p.repoUrl ?? "#"}
              target={p.liveUrl || p.repoUrl ? "_blank" : undefined}
              rel={p.liveUrl || p.repoUrl ? "noopener noreferrer" : undefined}
              class="grid grid-cols-1 items-baseline gap-6 py-10 md:grid-cols-[auto_1fr_auto_auto] md:gap-12 md:py-14"
            >
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
                {String(i + 1).padStart(2, "0")}
              </span>

              <div class="flex flex-col gap-3">
                <h3 class="font-display text-4xl tracking-[-0.025em] text-primary transition-transform duration-500 group-hover:translate-x-2 md:text-5xl">
                  {p.title}
                </h3>
                <p class="max-w-xl text-secondary text-base leading-[1.55]">{p.summary}</p>
                <ul class="mt-2 flex flex-wrap gap-x-2 gap-y-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
                  {p.tags.map((tag) => (
                    <li class="rounded-full border border-border px-3 py-1">{tag}</li>
                  ))}
                </ul>
              </div>

              <span class="hidden font-mono text-xs uppercase tracking-[0.2em] text-secondary md:inline">
                {p.year}
              </span>

              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-border text-secondary transition-colors group-hover:border-primary group-hover:text-primary">
                <ArrowUpRight size={18} stroke-width={1.5} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
