---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

// Font URLs for critical preload — Vite hashes these at build so preloads
// always resolve to the correct asset name.
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.name,
  description = site.description,
  ogImage = site.ogImage,
} = Astro.props;

const pageTitle = title === site.name ? `${site.name} — ${site.role}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com").toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? "https://example.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Preconnect nothing external; fonts and assets are self-hosted -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatinUrl}
      crossorigin="anonymous"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Sitemap discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="bg-bg text-primary antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[999] focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import { initNav } from "../lib/nav";
      import { initReveals } from "../lib/splitReveal";
      import { initFloatingIcons, destroyFloatingIcons } from "../lib/floatingIcons";

      initNav();
      initReveals();
      initFloatingIcons();

      // Tidy up GSAP tweens + listeners if Astro view transitions swap the page.
      document.addEventListener("astro:before-swap", () => {
        destroyFloatingIcons();
      });
      document.addEventListener("astro:page-load", () => {
        initFloatingIcons();
      });
    </script>
  </body>
</html>
